*[_type == "advisor" && status == "active"] | order(name asc) {
  name,
  title,
  email,
  phone,
  credentials,
  "city": location.city,
  "state": location.state,
  "profileUrl": "https://www.farther.com/advisor/" + slug.current,
  "headshotUrl": photo.asset->url,
  "team": coalesce(
    *[_type == "partnerMicrosite" && references(^._id) && count(string::split(slug.current, "/")) == 1][0]{
      "name": title,
      "url": "https://www.farther.com/teams/" + slug.current,
      "logoUrl": coalesce(nav.logo.asset->url, sections[_type == "pm.hero"][0].logo.asset->url)
    },
    *[_type == "team" && references(^._id)][0]{
      name,
      "url": "https://www.farther.com/teams/" + slug.current,
      "logoUrl": logo.asset->url
    }
  )
}
